{
  "token_utilization_spec": {
    "description": "Open, live token-utilisation signals at model level, drilled down to KPI and country level. Live leaderboard endpoints only - no periodic PDF/report sources.",
    "refresh_with_primary": true,
    "max_models_per_slice": 10,
    "kpis": [
      {
        "id": "tokens_processed",
        "label": "Tokens processed",
        "unit": "tokens",
        "higher_is_better": true,
        "description": "Total tokens routed through the source in the trailing window."
      },
      {
        "id": "token_share_pct",
        "label": "Token share",
        "unit": "percent",
        "higher_is_better": true,
        "description": "Model's share of all tokens captured in the same slice."
      },
      {
        "id": "token_growth_pct",
        "label": "Weekly growth",
        "unit": "percent",
        "higher_is_better": true,
        "description": "Change in tokens processed versus the previous window."
      },
      {
        "id": "country_token_share_pct",
        "label": "Country token share",
        "unit": "percent",
        "higher_is_better": true,
        "description": "Share of tokens attributed to the model developer's home country."
      },
      {
        "id": "models_in_country",
        "label": "Models per country",
        "unit": "count",
        "higher_is_better": true,
        "description": "Distinct models from that country present in the captured slices."
      }
    ],
    "slices": [
      { "id": "overall", "label": "All categories", "url": "https://openrouter.ai/rankings" },
      { "id": "programming", "label": "Programming", "url": "https://openrouter.ai/rankings?category=programming" },
      { "id": "roleplay", "label": "Roleplay", "url": "https://openrouter.ai/rankings?category=roleplay" },
